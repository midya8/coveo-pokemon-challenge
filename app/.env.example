# Anonymous search token. Safe to ship in the browser bundle.
# Without it, the app uses Coveo's public sample organization.
VITE_COVEO_ORG_ID=voljzmfhemcvoorg
VITE_COVEO_API_KEY=
VITE_COVEO_SEARCH_HUB=PokemonSearch

# Leave empty so the search-hub condition selects the "Pokemon Search" pipeline.
VITE_COVEO_PIPELINE=

# Platform admin key for tools/apply_pipeline.py and tools/coveo_setup.py.
# Export it in the shell. Do not prefix it with VITE_, or Vite would expose it
# to the browser. Never commit a real value.
# COVEO_ORG_ID=voljzmfhemcvoorg
# COVEO_ADMIN_API_KEY=
